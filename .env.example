# Copier ce fichier en .env (ignoré par git) et renseigner les valeurs.

# Email Google du premier administrateur (obligatoire tant qu'aucun ADMIN n'existe en base)
INITIAL_ADMIN_EMAIL=prenom.nom@gmail.com

# Client OAuth Google « Application Web » (Google Cloud Console > API et services > Identifiants)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base PostgreSQL (valeurs par défaut de compose.yaml en développement)
DATABASE_URL=jdbc:postgresql://localhost:5432/carsupervision
DATABASE_USERNAME=carsupervision
DATABASE_PASSWORD=carsupervision
