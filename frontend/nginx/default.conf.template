# Configuration nginx du frontend (variables remplacées au démarrage par l'image nginx).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Résolution DNS au moment de la requête (DNS interne de Docker) : le frontend démarre même
    # si le backend n'est pas encore lancé, et répond 502 sur l'API tant qu'il est absent.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend ${BACKEND_URL};

    # Routes servies par le backend : API, connexion Google, déconnexion, contrat, Swagger UI.
    location ~ ^/(api|oauth2|login|logout|openapi\.yaml|swagger-ui|v3|actuator|access-denied\.html) {
        proxy_pass $backend;
        # Hôte d'origine conservé : l'URI de retour Google reste celle vue par le navigateur
        # (http://localhost:5173/login/oauth2/code/google en local). X-Forwarded-Host porte aussi
        # le port : sans lui, Spring retire le port de l'URI dès que X-Forwarded-Proto est présent.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Fichiers construits par Vite : noms avec empreinte, mis en cache longtemps.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Routes de la SPA : repli vers index.html, jamais mis en cache.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
